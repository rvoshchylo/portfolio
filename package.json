{
  "name": "portos-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PortOS — Ruslan Voshchylo's developer portfolio, styled as a tiny desktop OS.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
